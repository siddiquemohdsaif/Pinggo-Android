<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.LoginActivity">

    <TextView
        android:id="@+id/countryFlagTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="countryFlagTextView" />

    <ImageView
        android:id="@+id/backgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/pinggo_login_background" />

    <ScrollView
        android:id="@+id/loginScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="760dp"
            android:paddingTop="96dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/pinggoLogoImageView"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/app_logo"
                android:src="@drawable/pinggo_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/loginTitleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-15dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/pinggo_brand"
                android:textColor="@color/pinggo_title"
                android:textSize="45sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pinggoLogoImageView" />

            <TextView
                android:id="@+id/loginTaglineTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/pinggo_tagline"
                android:textColor="@color/pinggo_body_text"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:textFontWeight="1000"
                app:layout_constraintTop_toBottomOf="@id/loginTitleTextView" />

            <TextView
                android:id="@+id/loginSecurityTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/pinggo_security"
                android:textColor="@color/pinggo_action"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/loginTaglineTextView" />

            <LinearLayout
                android:id="@+id/phoneCardContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="115dp"
                android:background="@drawable/bg_pinggo_card"
                android:elevation="3dp"
                android:gravity="center_horizontal"
                android:outlineAmbientShadowColor="@color/pinggo_card_shadow_ambient"
                android:outlineSpotShadowColor="@color/pinggo_card_shadow_spot"
                android:orientation="vertical"
                android:paddingStart="25dp"
                android:paddingTop="28dp"
                android:paddingEnd="25dp"
                android:paddingBottom="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/loginSecurityTextView">

                <TextView
                    android:id="@+id/phoneCardTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/enter_phone_number"
                    android:textColor="@color/primary_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/verificationHintTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/verification_code_hint"
                    android:textColor="@color/pinggo_body_text"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="18dp">

                    <com.hbb20.CountryCodePicker
                        android:id="@+id/countryCodePicker"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_pinggo_input"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="44dp"
                        app:ccp_autoDetectCountry="true"
                        app:ccp_contentColor="@color/primary_text"
                        app:ccp_defaultNameCode="IN"
                        app:ccp_showArrow="false"
                        app:ccp_showFlag="true"
                        app:ccp_showFullName="true"
                        app:ccp_showNameCode="false"
                        app:ccp_showPhoneCode="false"
                        app:ccp_textSize="16sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="18dp"
                        android:layout_marginBottom="16dp"
                        android:clickable="false"
                        android:contentDescription="@null"
                        android:focusable="false"
                        android:src="@drawable/ic_dropdown_down" />

                    <TextView
                        android:id="@+id/countryLabelTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@color/white"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/country"
                        android:textColor="@color/pinggo_muted_text"
                        android:textSize="12sp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:id="@+id/phoneInputContainer"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_pinggo_phone_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/phoneCodeTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="+91"
                            android:textColor="@color/primary_text"
                            android:textSize="18sp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="25dp"
                            android:layout_marginStart="18dp"
                            android:background="@color/pinggo_input_stroke" />

                        <EditText
                            android:id="@+id/phoneNumberEditText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:autofillHints="phone"
                            android:background="@android:color/transparent"
                            android:hint="@string/phone_number"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:textColor="@color/primary_text"
                            android:textColorHint="@color/secondary_text"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/phoneLabelTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@color/white"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/phone_number"
                        android:textColor="@color/pinggo_action"
                        android:textSize="12sp" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/securityMessageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pinggo_lock" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/phone_safe_message"
                        android:textColor="@color/pinggo_body_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/getOtpButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/bg_pinggo_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/next"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="28dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pinggo_arrow"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/otpHintTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/otp_hint"
                    android:textColor="@color/secondary_text"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/otpEditText"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="smsOTPCode"
                    android:background="@drawable/bg_pinggo_input"
                    android:hint="@string/enter_otp"
                    android:inputType="number"
                    android:maxLength="6"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/secondary_text"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/confirmButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/confirm"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/termsTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/terms_notice"
                android:textColor="@color/pinggo_muted_text"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/phoneCardContainer" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
