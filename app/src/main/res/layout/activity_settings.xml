<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:padding="20dp"
    tools:context=".activity.SettingsActivity">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/settings"
            android:textColor="@color/primary_text"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRow">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profilePhotoImageView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_input"
            android:contentDescription="@string/profile_photo"
            android:padding="32dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.WaveStream.Circle" />

        <Button
            android:id="@+id/editProfilePhotoButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/edit_profile_photo"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/nameRow"
            style="@style/Widget.WaveStream.SettingsRow">

            <TextView
                style="@style/Widget.WaveStream.SettingsLabel"
                android:text="@string/name" />

            <TextView
                android:id="@+id/nameValueTextView"
                style="@style/Widget.WaveStream.SettingsValue"
                tools:text="Test User" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/descriptionRow"
            style="@style/Widget.WaveStream.SettingsRow">

            <TextView
                style="@style/Widget.WaveStream.SettingsLabel"
                android:text="@string/description" />

            <TextView
                android:id="@+id/descriptionValueTextView"
                style="@style/Widget.WaveStream.SettingsValue"
                tools:text="Hey There !" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phoneRow"
            style="@style/Widget.WaveStream.SettingsRow">

            <TextView
                style="@style/Widget.WaveStream.SettingsLabel"
                android:text="@string/phone_number" />

            <TextView
                android:id="@+id/phoneValueTextView"
                style="@style/Widget.WaveStream.SettingsValue"
                tools:text="&lt;plus&gt;1234567890" />
        </LinearLayout>

        <Button
            android:id="@+id/logOutButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/log_out" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cropContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/screen_background"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_crop_region"
            android:textColor="@color/primary_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.w3n.wavestream.views.CropImageView
            android:id="@+id/cropImageView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retryCropButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/retry" />

            <Button
                android:id="@+id/okCropButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@android:string/ok" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
