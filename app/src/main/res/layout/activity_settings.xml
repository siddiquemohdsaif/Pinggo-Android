<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:padding="20dp"
    tools:context=".activity.SettingsActivity">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/settings"
            android:textColor="@color/primary_text"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRow">

        <LinearLayout
            android:id="@+id/nameRow"
            style="@style/Widget.WaveStream.SettingsRow">

            <TextView
                style="@style/Widget.WaveStream.SettingsLabel"
                android:text="@string/name" />

            <TextView
                android:id="@+id/nameValueTextView"
                style="@style/Widget.WaveStream.SettingsValue"
                tools:text="Test User" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dobRow"
            style="@style/Widget.WaveStream.SettingsRow">

            <TextView
                style="@style/Widget.WaveStream.SettingsLabel"
                android:text="@string/dob" />

            <TextView
                android:id="@+id/dobValueTextView"
                style="@style/Widget.WaveStream.SettingsValue"
                tools:text="2000-01-02" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emailRow"
            style="@style/Widget.WaveStream.SettingsRow">

            <TextView
                style="@style/Widget.WaveStream.SettingsLabel"
                android:text="@string/email" />

            <TextView
                android:id="@+id/emailValueTextView"
                style="@style/Widget.WaveStream.SettingsValue"
                tools:text="test@example.com" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phoneRow"
            style="@style/Widget.WaveStream.SettingsRow">

            <TextView
                style="@style/Widget.WaveStream.SettingsLabel"
                android:text="@string/phone_number" />

            <TextView
                android:id="@+id/phoneValueTextView"
                style="@style/Widget.WaveStream.SettingsValue"
                tools:text="&lt;plus&gt;1234567890" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
