<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sign_up_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.SignUpActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/sign_up_fragment_container"
        android:name="com.w3n.pinggo.fragment.signup.ProfileSetupFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/sign_up_status_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/login_system_bar_background"
        android:clickable="false"
        android:importantForAccessibility="no" />

    <com.w3n.pinggo.views.common.BlockingProgressView
        android:id="@+id/blocking_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

</FrameLayout>
